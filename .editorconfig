root = true

[*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

# C# code style
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_prefer_braces = true:suggestion

# Analyzer severities
# Avoid breaking build on missing XML docs
dotnet_diagnostic.CS1591.severity = none
# Async method lacks await
dotnet_diagnostic.CS1998.severity = suggestion
# General formatting suggestions
dotnet_diagnostic.IDE0055.severity = warning

# StyleCop: do not fail build initially
# Use category key to lower all StyleCop rules
# Category name used by StyleCop.Analyzers
# See: https://github.com/DotNetAnalyzers/StyleCopAnalyzers
# Some runners use 'StyleCop.CSharp', include both for safety

# If the category key isn't recognized in your environment, fall back to SA* patterns.
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.severity = suggestion

dotnet_diagnostic.SA*.severity = suggestion

# Lower noisy CA rules to suggestions initially
dotnet_diagnostic.CA2007.severity = suggestion
dotnet_diagnostic.CA1031.severity = suggestion
dotnet_diagnostic.CA1062.severity = suggestion
dotnet_diagnostic.CA1822.severity = suggestion
dotnet_diagnostic.CA1724.severity = suggestion
dotnet_diagnostic.CA1845.severity = suggestion
